local WALLET_ID = 900

local byId: { [number]: Card } = {}
Cards.numberedIds = {} :: { number }
Cards.freeIds = {} :: { number }
Cards.spellIds = {} :: { number }

local function add(card: Card)
	byId[card.id] = card
end

for _, row in NUMBERED do
	add({
		id = row[1],
		name = row[2],
		rank = row[3],
		kind = row[4],
		source = row[5],
		desc = row[6],
		numbered = true,
		spell = false,
		free = false,
	})
	table.insert(Cards.numberedIds, row[1])
end

for _, row in FREE do
	add({
		id = row[1],
		name = row[2],
		rank = row[3],
		kind = row[4],
		source = row[5],
		desc = row[6],
		numbered = false,
		spell = false,
		free = true,
	})
	table.insert(Cards.freeIds, row[1])
end

for _, spell in Spells.list do
	add({
		id = spell.id,
		name = spell.name,
		rank = spell.rank,
		kind = "spell",
		source = "s:spells:" .. spell.price,
		desc = spell.desc,
		numbered = false,
		spell = true,
		free = true,
	})
	table.insert(Cards.spellIds, spell.id)
end

add({
	id = WALLET_ID,
	name = "Кошелёк",
	rank = "H",
	kind = "wallet",
	source = "x:wallet",
	desc = "Йены существуют на острове только в виде карты.",
	numbered = false,
	spell = false,
	free = true,
})

Cards.WALLET_ID = WALLET_ID
Cards.BLESSING_ID = 1

function Cards.get(id: number): Card?
	return byId[id]
end

function Cards.isNumbered(id: number): boolean
	local card = byId[id]
	return card ~= nil and card.numbered
end

function Cards.isSpell(id: number): boolean
	local card = byId[id]
	return card ~= nil and card.spell
end

--- Разбор source: {type="p", zone=...} / {type="s", shop=..., price=...} / ...
function Cards.parseSource(source: string): { type: string, arg: string?, price: number? }
	local parts = string.split(source, ":")
	return { type = parts[1], arg = parts[2], price = tonumber(parts[3]) }
end

--- Карты, источник которых — заданный тип и аргумент (например "m", "Cyclops").
function Cards.withSource(sourceType: string, arg: string?): { Card }
	local found = {}
	for _, id in Cards.numberedIds do
		local card = byId[id]
		local parsed = Cards.parseSource(card.source)
		if parsed.type == sourceType and (arg == nil or parsed.arg == arg) then
			table.insert(found, card)
		end
	end
	for _, id in Cards.freeIds do
		local card = byId[id]
		local parsed = Cards.parseSource(card.source)
		if parsed.type == sourceType and (arg == nil or parsed.arg == arg) then
			table.insert(found, card)
		end
	end
	return found
end

return Cards
