-- 40 карт заклинаний (свободные слоты). Продаются только в Масадоре; «Получить» читает заклинание.
-- Когда заклинание использовано, запас магазина пополняется.
-- effect/params разбирает server/SpellService.luau.
export type Spell = {
	id: number,
	name: string,
	rank: string,
	price: number,
	effect: string,
	params: { [string]: any },
	desc: string,
}

local function spell(id: number, name: string, rank: string, price: number, effect: string, params: { [string]: any }, desc: string): Spell
	return { id = id, name = name, rank = rank, price = price, effect = effect, params = params, desc = desc }
end

